# Ignore everything by default
*

# Keep the .gitignore file itself
!.gitignore

# Keep Cursor project rules
!.cursor/
!.cursor/**

# Keep CI for the parent submodule pointer
!.github/
!.github/**

# Keep the icon
!icon.png

# Keep the forge directory
!forge/
!forge/**

# Keep the public Forge landing page
!forge-landing/
!forge-landing/**

# Keep the Supabase backend boundary
!forge-backend/
!forge-backend/**

# Keep the the forge mobile app
!forge-mobile/
!forge-mobile/**

# (Optional) Keep README if you add one later
#!README.md
